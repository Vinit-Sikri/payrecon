{
  "name": "@payrecon/ingestion",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.js --external:@prisma/client --external:@fastify/swagger-ui --external:@fastify/static",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@payrecon/db": "*",
    "@payrecon/shared": "*",
    "csv-parse": "^7.0.1",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
