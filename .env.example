# =============================================================================
# Local development (docker-compose postgres/redis, host-mapped ports).
# For production, point these at your Neon/Supabase Postgres and Upstash
# Redis URLs instead — see README for sign-up + connection-string notes.
# Note: when running the app services THROUGH docker-compose (not `npm run
# dev:*`), docker-compose.yml overrides DATABASE_URL/REDIS_URL to use the
# in-network hostnames (postgres/redis) instead of localhost automatically.
# =============================================================================
DATABASE_URL="postgresql://payrecon:payrecon@localhost:5433/payrecon"
REDIS_URL="redis://localhost:6380"

NODE_ENV=development
LOG_LEVEL=info

# --- Ingestion service ---
INGESTION_PORT=3000
INGESTION_HOST=0.0.0.0
IDEMPOTENCY_TTL_SECONDS=86400

# --- Mock gateway ---
MOCK_GATEWAY_PORT=4000
MOCK_GATEWAY_HOST=0.0.0.0
INGESTION_WEBHOOK_URL="http://localhost:3000/webhooks/payments"
MIN_DELAY_MS=500
MAX_DELAY_MS=4000
FAILURE_RATE=0.15
PENDING_RATE=0.1
DUPLICATE_RATE=0.15
WEBHOOK_MAX_ATTEMPTS=3

# --- Shared between mock-gateway (signs) and ingestion (verifies) ---
# Generate your own, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_HMAC_SECRET="change-me-to-a-random-32-byte-hex-string"

# --- Reconciliation worker ---
WORKER_HEALTH_PORT=4100
WORKER_HEALTH_HOST=0.0.0.0
RECONCILIATION_MAX_ATTEMPTS=5
RECONCILIATION_DELAY_THRESHOLD_MS=3600000
RECONCILIATION_LOCK_TTL_MS=30000
STREAM_BLOCK_MS=5000
STREAM_BATCH_SIZE=10
RETRY_POLL_INTERVAL_MS=5000
