generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

enum ReconciliationState {
  PENDING
  MATCHED
  MISMATCHED
  FAILED
  DEAD_LETTERED
}

enum MismatchReason {
  AMOUNT_MISMATCH
  MISSING_ORDER
  DUPLICATE_PAYMENT
  DELAYED_WEBHOOK
  STATUS_CONFLICT
}

enum LedgerAccountType {
  GATEWAY_RECEIVABLE
  MERCHANT_PAYABLE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryStatus {
  PENDING_SETTLEMENT
  SETTLED
}

enum SettlementBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum SettlementMatchStatus {
  MATCHED
  AMOUNT_MISMATCH
  UNMATCHED
}

model Order {
  id        String      @id @default(uuid())
  amount    Int // minor units (e.g. cents)
  currency  String      @db.VarChar(3)
  status    OrderStatus @default(CREATED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  paymentEvents PaymentEvent[]
  ledgerEntries LedgerEntry[]

  @@index([status])
  @@map("orders")
}

model PaymentEvent {
  id             String  @id @default(uuid())
  idempotencyKey String  @unique
  gatewayEventId String  @unique
  orderId        String?
  order          Order?  @relation(fields: [orderId], references: [id])

  amount       Int // minor units
  currency     String        @db.VarChar(3)
  gatewayStatus PaymentStatus

  reconciliationState ReconciliationState @default(PENDING)
  attempts            Int                 @default(0)
  lastError           String?

  rawPayload  Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  mismatches        Mismatch[]
  ledgerEntries     LedgerEntry[]
  settlementRecords SettlementRecord[]

  @@index([reconciliationState])
  @@index([orderId])
  @@map("payment_events")
}

model Mismatch {
  id             String       @id @default(uuid())
  paymentEventId String
  paymentEvent   PaymentEvent @relation(fields: [paymentEventId], references: [id])
  reason         MismatchReason
  detail         Json
  createdAt      DateTime     @default(now())

  @@index([reason])
  @@map("mismatches")
}

model DeadLetterEvent {
  id             String   @id @default(uuid())
  paymentEventId String   @unique
  payload        Json
  reason         String
  attempts       Int
  failedAt       DateTime @default(now())

  @@map("dead_letter_events")
}

model LedgerEntry {
  id             String            @id @default(uuid())
  paymentEventId String
  paymentEvent   PaymentEvent      @relation(fields: [paymentEventId], references: [id])
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id])

  accountType LedgerAccountType
  direction   LedgerDirection
  amount      Int // minor units, always positive; sign comes from direction
  currency    String            @db.VarChar(3)

  status             LedgerEntryStatus @default(PENDING_SETTLEMENT)
  settlementRecordId String?
  settlementRecord   SettlementRecord? @relation(fields: [settlementRecordId], references: [id])
  createdAt          DateTime          @default(now())
  settledAt          DateTime?

  @@index([paymentEventId])
  @@index([status])
  @@index([accountType])
  @@map("ledger_entries")
}

model SettlementBatch {
  id              String                @id @default(uuid())
  filename        String
  fileHash        String                @unique
  uploadedAt      DateTime              @default(now())
  status          SettlementBatchStatus @default(PROCESSING)
  totalRecords    Int                   @default(0)
  matchedCount    Int                   @default(0)
  mismatchedCount Int                   @default(0)
  unmatchedCount  Int                   @default(0)

  records SettlementRecord[]

  @@map("settlement_batches")
}

model SettlementRecord {
  id                String                @id @default(uuid())
  settlementBatchId String
  settlementBatch   SettlementBatch       @relation(fields: [settlementBatchId], references: [id])

  gatewayEventId String
  amount         Int // minor units
  currency       String                @db.VarChar(3)
  settledAt      DateTime
  matchStatus    SettlementMatchStatus

  paymentEventId String?
  paymentEvent   PaymentEvent?         @relation(fields: [paymentEventId], references: [id])

  ledgerEntries LedgerEntry[]
  createdAt     DateTime              @default(now())

  @@index([settlementBatchId])
  @@index([gatewayEventId])
  @@map("settlement_records")
}
